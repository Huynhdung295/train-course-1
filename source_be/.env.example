# ─── BACKEND ENVIRONMENT VARIABLES TEMPLATE ───────────────────────────────────
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# NEVER commit .env to source control!
# ──────────────────────────────────────────────────────────────────────────────

# Profile selection (local | dev | staging | prod)
SPRING_PROFILES_ACTIVE=local

# ─── Database ─────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/ecommerce_dev
DB_USERNAME=dev_user
DB_PASSWORD=dev_password

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ─── JWT Security ─────────────────────────────────────────────────────────────
# IMPORTANT: Replace with a 256-bit random secret in production!
# Generate one with: openssl rand -hex 32
JWT_SECRET=changeme-insecure-local-dev-secret-must-be-at-least-32-characters-long
JWT_ACCESS_EXPIRY=3600      # seconds (1 hour)
JWT_REFRESH_EXPIRY=604800   # seconds (7 days)

# ─── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
