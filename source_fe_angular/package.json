{
  "name": "nexus-erp-frontend",
  "version": "1.0.0",
  "description": "Nexus ERP & POS — Enterprise Multi-Tenant Frontend (Angular 22)",
  "scripts": {
    "start": "ng serve",
    "start:staging": "ng serve --configuration=staging",
    "build": "ng build",
    "build:staging": "ng build --configuration=staging",
    "build:prod": "ng build --configuration=production",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write 'src/**/*.{ts,html,scss}'",
    "format:check": "prettier --check 'src/**/*.{ts,html,scss}'",
    "analyze": "ng build --stats-json && webpack-bundle-analyzer dist/nexus-erp-frontend/browser/stats.json",
    "docs:storybook": "storybook dev -p 6006",
    "compodoc": "compodoc -p tsconfig.doc.json -d docs/compodoc --serve"
  },
  "private": true,
  "overrides": {
    "@angular/core": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/router": "^22.0.0"
  },
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.0",
    "@ngrx/signals": "^19.0.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "chart.js": "^4.4.0",
    "ng2-charts": "^6.0.0",
    "date-fns": "^3.6.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular-eslint/builder": "^19.0.0",
    "@angular-eslint/eslint-plugin": "^19.0.0",
    "@angular-eslint/eslint-plugin-template": "^19.0.0",
    "@angular-eslint/schematics": "^19.0.0",
    "@angular-eslint/template-parser": "^19.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@playwright/test": "^1.45.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.0",
    "ts-jest": "^29.1.0",
    "typescript": "~5.5.0",
    "webpack-bundle-analyzer": "^4.10.0"
  },
  "lint-staged": {
    "src/**/*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.scss": [
      "prettier --write"
    ]
  }
}
