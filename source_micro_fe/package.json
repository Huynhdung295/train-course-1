{
  "name": "nexus-micro-fe",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:shell": "pnpm --filter @nexus/shell dev",
    "dev:auth": "pnpm --filter @nexus/mfe-auth dev",
    "dev:pos": "pnpm --filter @nexus/mfe-pos dev",
    "dev:erp": "pnpm --filter @nexus/mfe-erp dev",
    "dev:catalog": "pnpm --filter @nexus/mfe-catalog dev",
    "dev:users": "pnpm --filter @nexus/mfe-users dev",
    "dev:marketing": "pnpm --filter @nexus/mfe-marketing dev",
    "build": "turbo run build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,vue,json,md}\"",
    "devkit": "node devkit/server.js"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "prettier": "^3.4.0",
    "webpack": "^5.98.0"
  }
}
